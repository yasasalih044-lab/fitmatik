# --- Üretici seçimi ---
# openai: şimdilik doğrudan OpenAI API'ı kullanır.
# hermes: üretimi Hermes'e devreder (Hermes de Codex aboneliğiyle Jett skill'ini çalıştırır).
STUDIO_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=sk-proj-...
# Planlama ve tasarım yönleri için metin modeli
OPENAI_TEXT_MODEL=gpt-5-mini
# Arka plan görselleri için görsel modeli (hesabında açık olan modelin tam adını yaz)
OPENAI_IMAGE_MODEL=gpt-image-1
# low | medium | high — kalite arttıkça süre ve maliyet artar
OPENAI_IMAGE_QUALITY=medium

# --- Hermes (STUDIO_PROVIDER=hermes iken) ---
# Sözleşme: docs/hermes-contract.md
HERMES_URL=https://hermes.mavrosai.site
HERMES_TOKEN=uzun-rastgele-bir-anahtar

# --- Giriş ---
# Üretimde zorunlu. Stüdyoya yalnızca bu şifreyi bilen girer.
STUDIO_PASSWORD=guclu-bir-sifre
# Üretimde zorunlu: en az 32 baytlık, sabit ve rastgele bir değer.
STUDIO_SECRET=en-az-32-baytlik-sabit-rastgele-bir-gizli-deger
